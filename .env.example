# Clé d'API Gemini (aistudio.google.com/apikey). À renseigner dans Vercel > Settings > Environment Variables.
GEMINI_API_KEY=

# Code d'accès à l'application. FORTEMENT recommandé : sans lui, toute personne qui connaît
# l'adresse du site peut consommer ton quota Gemini (ou ta facture). Prends une phrase longue
# (16 caractères ou plus). Laisse vide pour un accès libre.
ACCESS_CODE=

# Optionnel : modèle utilisé pour lire la vidéo (défaut : gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
